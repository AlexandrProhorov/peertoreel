{
  "name": "@kadence/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema and database handle shared by API and worker",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@kadence/contracts": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
