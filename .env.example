# Runtime
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200

# Infrastructure
DATABASE_URL=postgresql://peertoreel:peertoreel@localhost:5432/peertoreel
REDIS_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=1

# Media tools (absolute path avoids depending on the terminal PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Stock visuals (Pixabay). Optional at boot; the visuals stage fails with a
# clear message when the key is missing.
# PIXABAY_API_KEY=

# Auth
# Session lifetime in hours (7 days by default).
SESSION_TTL_HOURS=168
# First admin, created only while the users table is empty. Remove after the
# first successful login.
BOOTSTRAP_ADMIN_EMAIL=owner@peertoreel.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-before-first-run

# Object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=peertoreel
S3_ACCESS_KEY=peertoreel
S3_SECRET_KEY=peertoreel-dev-secret
S3_FORCE_PATH_STYLE=true

# TikTok Login Kit + Content Posting API (M1.2a)
# 1. Create an app at https://developers.tiktok.com/
# 2. Add Login Kit and Content Posting API, request user.info.basic + video.publish
# 3. Register this redirect URI in the app: http://localhost:3000/api/v1/accounts/tiktok/callback
# Tokens are stored encrypted with TOKEN_ENCRYPTION_KEY. Generate it once and
# keep it stable (base64 or 64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:3000/api/v1/accounts/tiktok/callback
# TOKEN_ENCRYPTION_KEY=
# WEB_APP_URL=http://localhost:4200
