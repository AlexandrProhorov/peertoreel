# Runtime
NODE_ENV=development
PORT=3000
APP_VERSION=0.1.0
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:4200

# Infrastructure
DATABASE_URL=postgresql://kadence:kadence@localhost:5432/kadence
REDIS_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=1

# Object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=kadence
S3_ACCESS_KEY=kadence
S3_SECRET_KEY=kadence-dev-secret
S3_FORCE_PATH_STYLE=true
