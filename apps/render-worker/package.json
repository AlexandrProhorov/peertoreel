{
  "name": "@peertoreel/render-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion scene renderer for the animated factory",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prerender-fixture": "pnpm --filter @peertoreel/contracts build",
    "render-fixture": "tsx src/cli.ts render-fixture",
    "render-storyboard": "tsx src/cli.ts render-storyboard",
    "ui:demo": "tsx src/ui-demo/cli.ts",
    "ui:lint": "tsx src/ui-demo/lint/cli.ts",
    "ui:motion": "tsx src/ui-demo/motion/cli.ts",
    "ui:variants": "tsx src/ui-demo/variants/build.ts",
    "ui:variants:report": "tsx src/ui-demo/variants/report.ts",
    "ui:fidelity": "tsx src/ui-demo/fidelity-cli.ts",
    "ui:direct": "tsx src/ui-demo/director/cli.ts",
    "ui:gallery": "tsx src/ui-demo/gallery/build.ts",
    "ui:film": "tsx src/ui-demo/film/cli.ts",
    "ui:assemble": "tsx src/ui-demo/film/assemble.ts",
    "ui:visual": "tsx src/ui-demo/visual/cli.ts",
    "ui:fit": "tsx src/ui-demo/fit/cli.ts",
    "recolor:starter": "tsx src/recolor-starter.ts",
    "pilot:deepseek-svg": "tsx src/pilot-deepseek-svg.ts",
    "ensure-browser": "tsx src/ensure-browser.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@peertoreel/assets": "workspace:*",
    "@peertoreel/contracts": "workspace:*",
    "@peertoreel/db": "workspace:*",
    "@peertoreel/providers": "workspace:*",
    "@peertoreel/storage": "workspace:*",
    "@remotion/bundler": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "dotenv": "^18.0.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
