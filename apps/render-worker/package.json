{
  "name": "@peertoreel/render-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remotion scene renderer for the animated factory",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "prerender-fixture": "pnpm --filter @peertoreel/contracts build",
    "render-fixture": "tsx src/cli.ts render-fixture",
    "ensure-browser": "tsx src/ensure-browser.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@peertoreel/contracts": "workspace:*",
    "@remotion/bundler": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
