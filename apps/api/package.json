    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.5.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "prettier": "^3.8.1",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
