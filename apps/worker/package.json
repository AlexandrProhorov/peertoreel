{
  "name": "@kadence/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kadence background worker",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tiktok:spike": "tsx src/tiktok/tiktok-spike.ts"
  },
  "dependencies": {
    "@kadence/contracts": "workspace:*",
    "@kadence/db": "workspace:*",
    "@kadence/storage": "workspace:*",
    "@kadence/tiktok": "workspace:*",
    "bullmq": "^6.5.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
